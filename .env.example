# 관리자 첫 로그인(아이디 admin)의 비밀번호. 로그인 후 관리자에서 변경하면 이 값은 쓰이지 않습니다.
ADMIN_PASSWORD=
# 로그인 유지와 계정 암호화에 쓰는 키. 32자 이상 임의 문자열. 바꾸면 모든 계정이 초기화됩니다.
ADMIN_SECRET=
# Vercel Blob 저장소 토큰. Vercel에서 Blob을 연결하면 자동으로 들어옵니다.
# Vercel이 저장소를 OIDC 방식으로 연결하면 이 값 대신 BLOB_STORE_ID가 자동으로 들어가며, 그대로 동작합니다.
BLOB_READ_WRITE_TOKEN=
# 월 1회 자동 백업 호출을 확인하는 키. 임의 문자열.
CRON_SECRET=
# 정식 주소. 넣으면 검색 노출이 켜지고 robots·사이트맵·대표 주소가 이 주소로 바뀝니다.
NEXT_PUBLIC_SITE_URL=
# 견적 문의 메일: Resend API 키, 받는 주소(쉼표로 여러 개), 보내는 주소(도메인 인증 후. 비우면 Resend 테스트 발신)
RESEND_API_KEY=
INQUIRY_TO=
MAIL_FROM=
# 검색엔진 소유 확인 코드(구글 서치 콘솔 HTML 태그의 content 값, 네이버 서치어드바이저 HTML 태그의 content 값)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
